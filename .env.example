# Copy this file to `.env` and fill in your secrets. `.env` is gitignored.

# === LLM provider for AI summaries ============================================
# Pick ONE path. Default is "anthropic" if ANTHROPIC_API_KEY is set, else "bedrock".
# STOCK_BUZZ_PROVIDER=anthropic   # direct Anthropic API
# STOCK_BUZZ_PROVIDER=bedrock     # AWS Bedrock via your AWS credentials

# Override the model. Default is claude-opus-4-7. Set to claude-sonnet-4-6 (5x cheaper)
# or claude-haiku-4-5 (20x cheaper) if cost matters more than max quality.
# STOCK_BUZZ_MODEL=claude-opus-4-7

# --- Path A: Direct Anthropic API ---------------------------------------------
# Get one at https://console.anthropic.com → Settings → API keys.
# Pay-as-you-go billing on your Anthropic account.
ANTHROPIC_API_KEY=

# --- Path B: AWS Bedrock ------------------------------------------------------
# Uses your existing AWS credentials. Same per-token pricing as Anthropic API,
# but billed through AWS instead of Anthropic. Requires "Model access" enabled
# in the Bedrock console for the Claude models you want.
# AWS_PROFILE=PERSONAL_OSUNKWW
# AWS_REGION=us-east-1

# === Fundamentals provider (optional) =========================================
# Without this, the dashboard shows price/volume/52w-range only.
# With this, every ticker also shows: market cap, P/E ratio, EPS, dividend yield,
# beta, industry, prev/next earnings dates.
# Get a free key at https://finnhub.io/register (15 sec signup, 60 calls/min).
FINNHUB_API_KEY=

# === Reddit API credentials ===================================================
# Not yet required (Phase 1 uses public JSON endpoints).
# Once your Reddit API access is approved, fill these in.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=stock-buzz/0.1 by u/your_reddit_username
